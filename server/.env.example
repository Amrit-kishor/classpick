# ========================================================
# ClassPick Server Environment Configuration
# ========================================================

# Server Port
PORT=5001

# Node Environment: 'development', 'production', or 'test'
NODE_ENV=development

# Persistent MongoDB Connection String
# In production, this MUST point to a persistent MongoDB instance (e.g. MongoDB Atlas).
# In local development, you may leave this blank ONLY if ALLOW_IN_MEMORY_DB=true.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster_host>/classpick?retryWrites=true&w=majority

# Permit in-memory MongoDB fallback strictly in local development
# Set to 'false' in production.
ALLOW_IN_MEMORY_DB=true

# Seed demo faculty and sample classrooms
# MUST BE FALSE IN PRODUCTION to prevent default accounts with known credentials.
SEED_DEMO_DATA=false

# JSON Web Token Secret
# In production, this MUST be a high-entropy cryptographically random string (min 32 chars).
# Example to generate: openssl rand -base64 32
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters_long

# JWT Lifespan
JWT_EXPIRES_IN=7d

# Allowed Frontend Origin(s) for CORS and Cookie Access
# In production, set to your frontend domain (e.g. https://classpick.vercel.app).
# Multiple origins may be separated by commas.
CLIENT_URL=http://localhost:5180

# Cookie security settings (optional overrides; defaults to secure=true, sameSite=none in production)
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
